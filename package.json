{
  "name": "automd",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "smoke:frontend": "node scripts/frontend_smoke.mjs",
    "check": "npm run build && npm run smoke:frontend && cargo test --manifest-path src-tauri/Cargo.toml",
    "icons": "node scripts/generate_icons.mjs && tauri icon src-tauri/icons/icon.png",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:installers": "tauri build",
    "tauri:build:linux": "tauri build --bundles deb,appimage",
    "tauri:build:windows": "tauri build --bundles nsis,msi",
    "tauri:build:macos": "tauri build --bundles dmg",
    "tauri:build:app": "tauri build --bundles app",
    "tauri:build:dmg": "tauri build --bundles dmg"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.5.0",
    "molstar": "^5.9.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.5.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
